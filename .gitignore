# Public source repository. Everything is ignored by default; the allowlist below names what is published.
# Data (raw evidence, databases, releases), job state, local configuration and held-out material stay outside Git.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/MCP.md
!/LIMITATIONS.md
!/SECURITY.md
!/SOURCES.md
!/REPRODUCE.md
!/CONTRIBUTING.md
!/VERIFY.md
!/LICENSE
!/LICENSE-DATA-CC-BY-4.0.txt
!/NOTICE
!/LICENSING.md
!/CITATION.cff
!/pyproject.toml
!/label-history
!/label-history-mcp
!/gitrx/
!/gitrx_backend/
!/gitrx_services/
!/gitrx_core/
!/docs/
!/ops/
!/tools/
/tools/*
!/tools/verify_gitrx.py
!/tools/native_research_figures.py
!/runtime/
/runtime/*
!/runtime/native-config-rebuild-*.json
!/runtime/release-job-config.json
!/tests/
/tests/*
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/core_spl/
!/tests/fixtures/core_srlc/
!/tests/fixtures/core_golden/
!/tests/fixtures/core_changes/
!/tests/conftest.py
!/tests/test_core_*.py
!/tests/test_backend_portable.py
!/tests/test_fetch.py
!/tests/test_freshness.py
!/tests/test_interface_agreement.py
!/tests/test_rebuild_routes.py
!/tests/test_rebuild_search.py
!/tests/test_benchmark.py
!/tests/test_census.py
!/tests/test_change_clients.py
!/tests/test_changes.py
!/tests/test_core_changes.py
!/tests/test_core_dailymed_update.py
!/tests/test_core_evidence.py
!/tests/test_core_gap_repair.py
!/tests/test_core_rebuild.py
!/tests/test_core_spl_parser.py
!/tests/test_core_srlc.py
!/tests/test_core_srlc_grade.py
!/tests/test_core_srlc_precision.py
!/tests/test_core_srlc_update.py
!/tests/test_core_verify_gitrx.py
!/tests/test_core_workflow.py
!/tests/test_evidence_history_clients.py
!/tests/test_evidence_metadata.py
!/tests/test_mcp_cancellation.py
!/tests/test_mcp_discovery.py
!/tests/test_native_mcp_transport.py
!/tests/test_native_query.py
!/tests/test_phrase_history.py
!/tests/test_qualification.py
