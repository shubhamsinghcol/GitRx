!/tests/test_validation_study.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
# Local-only, never published
runtime/local.json
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store
