<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.gitrx.dailymed-weekly</string>
	<key>ProgramArguments</key>
	<array>
		<string>@GITRX_ROOT@/.venv/bin/python</string>
		<string>-B</string>
		<string>-m</string>
		<string>gitrx_core.dailymed_update</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@GITRX_ROOT@</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/GitRx/org.gitrx.dailymed-weekly.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/GitRx/org.gitrx.dailymed-weekly.err.log</string>
</dict>
</plist>
