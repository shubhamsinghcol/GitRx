#!/bin/sh
set -eu
GITRX_PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$GITRX_PROJECT"
# Default: the pinned 2026-11-12 rebuild with literal-search projection and observed-route lookup (GITRX_CONFIG=runtime/native-config-rebuild-0.2.4.json selects the identical release without them, exhaustive scan) (parser spl-sections-0.2.4; previous pins runtime/native-config-rebuild-0.2.3-delta-20261111.json and runtime/native-config-rebuild-0.2.3.json). No silent fallback to an older
# release: select one explicitly, e.g. GITRX_CONFIG=runtime/native-config.json (release1, retained).
GITRX_DEFAULT_CONFIG="$GITRX_PROJECT/runtime/native-config-rebuild-0.2.4-search.json"
exec "$GITRX_PROJECT/.venv/bin/python" -B -m gitrx_backend.cli --config "${GITRX_CONFIG:-$GITRX_DEFAULT_CONFIG}" "$@"
