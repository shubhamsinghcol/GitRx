#!/bin/sh
set -eu
GITRX_PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$GITRX_PROJECT"
if [ -f "$GITRX_PROJECT/runtime/release-job-config.json" ]; then
  GITRX_DEFAULT_JOB_CONFIG="$GITRX_PROJECT/runtime/release-job-config.json"
else
  GITRX_DEFAULT_JOB_CONFIG="$GITRX_PROJECT/reports/release-cycle-20261106/job-config.json"
fi
exec "$GITRX_PROJECT/.venv/bin/python" -B -m gitrx_backend.jobs --config "${GITRX_JOB_CONFIG:-$GITRX_DEFAULT_JOB_CONFIG}" "$@"
