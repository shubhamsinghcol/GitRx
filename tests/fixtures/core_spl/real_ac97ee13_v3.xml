               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">WARNINGS</content>
                     </content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20150922"/>
               <component>
                  <section>
                     <id root="7badb8fd-fe5c-4287-9e03-f69572a74966"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">When using this product:</content>
                        </paragraph>
                        <paragraph>• Avoid contact with eyes.  If contact occurs, rinse eyes thoroughly with water.</paragraph>
                     </text>
                     <effectiveTime value="20150922"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="a13641cd-e07c-4514-9897-bcf39c35a43d"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Stop use and ask a doctor if:</content>
                        </paragraph>
                        <paragraph>• Condition worsens or does not improve after regular use of this product as directed.</paragraph>
                     </text>
                     <effectiveTime value="20150922"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="702c19e9-b9a8-4761-904d-6bcf916b0035"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Keep this and all drugs out of reach of children.</content>  If swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
                     </text>
                     <effectiveTime value="20150922"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section>
               <id root="1c3eb63e-2645-47fc-9ebd-f6bd91ba728f"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Directions</content>
                     </content>
                  </paragraph>
                  <paragraph>Wet hair, massage into scalp, rinse.  Repeat if desired.  For best results use at least twice a week or as directed by a doctor.</paragraph>
               </text>
               <effectiveTime value="20150922"/>
            </section>
         </component>
