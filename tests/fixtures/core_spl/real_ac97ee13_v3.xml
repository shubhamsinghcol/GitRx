               <id root="2c398081-2658-4ce5-a8ae-1597603041ac"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Use</content>
                     </content>   Helps prevent and control recurrence of itching and flaking associated with dandruff</paragraph>
               </text>
               <effectiveTime value="20140422"/>
            </section>
         </component>
